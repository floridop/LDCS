# Copy this file in the system as /etc/logrotate.d/rucio
# Default paths as in the provided rucio.cfg are used
# If you change rucio.cfg you must also change this file
/var/log/rucio/*.log
/var/log/rucio/httpd/*_log {
    weekly
    missingok
    notifempty
    sharedscripts
    rotate 5
    compress
    delaycompress
    postrotate
       docker compose -f /home/almalinux/LDCS-rucio/docker-compose-rucioserver-postgres-daemons.yml restart rucio-server rucio-daemons-abacus rucio-daemons-reaper rucio-daemons-undertaker
    endscript
}

